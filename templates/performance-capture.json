{
  "id": "performance-capture",
  "title": "Performance capture release",
  "description": "A performer's likeness, voice and movement in a finished work, with no digital replica.",
  "public": [
    {
      "name": "aspects",
      "label": "What may be used",
      "type": "multiselect",
      "options": [
        "name",
        "image",
        "likeness",
        "voice",
        "movement",
        "mannerisms",
        "persona"
      ],
      "default": [
        "likeness",
        "voice",
        "movement",
        "mannerisms"
      ]
    },
    {
      "name": "permittedUses",
      "label": "Permitted uses",
      "type": "multiselect",
      "options": [
        "editorial",
        "promotional",
        "commercial",
        "archival"
      ],
      "default": [
        "promotional",
        "commercial",
        "archival"
      ]
    },
    {
      "name": "aiTraining",
      "label": "AI training",
      "type": "select",
      "options": [
        "notAllowed",
        "allowed"
      ],
      "default": "notAllowed"
    },
    {
      "name": "digitalReplica",
      "label": "Digital replica",
      "type": "select",
      "options": [
        "notAllowed",
        "allowed"
      ],
      "default": "notAllowed"
    },
    {
      "name": "territory",
      "label": "Territory (ISO 3166-1 alpha-2, or WORLD)",
      "type": "text",
      "default": "WORLD"
    }
  ],
  "private": [
    {
      "name": "engagement",
      "label": "Engagement",
      "type": "text",
      "default": "Photo shoot"
    },
    {
      "name": "fee",
      "label": "Fee",
      "type": "text",
      "default": "500.00"
    },
    {
      "name": "currency",
      "label": "Currency",
      "type": "text",
      "default": "USD"
    },
    {
      "name": "paymentTerms",
      "label": "Payment terms",
      "type": "text",
      "default": "Net 30 from signature"
    },
    {
      "name": "production",
      "label": "Production",
      "type": "text",
      "default": "Untitled short film"
    },
    {
      "name": "credit",
      "label": "On-screen credit",
      "type": "text",
      "default": "Featured performer"
    }
  ],
  "agreement": "PERFORMANCE CAPTURE RELEASE\n\nProduction: {{production}}\nCredit: {{credit}}\nEngagement: {{engagement}}\n\n{{participant}} grants {{producer}} permission to use their {{aspects}} as recorded in the attached final work, for {{permittedUses}} purposes in {{territory}}.\n\nAI training: {{aiTraining}}. Digital replica: {{digitalReplica}}. No new performance may be synthesized from this recording.\n\nFee: {{fee}} {{currency}}. Payment terms: {{paymentTerms}}.\n\nThe participant may withdraw this consent at any time; withdrawal applies to uses after it is recorded.",
  "credentialType": "ExampleGuildLikenessConsentCredential",
  "schemaId": "https://guild.example/consent/schemas/likeness-consent-credential.schema.json"
}
