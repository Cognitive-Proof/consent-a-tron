{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guild.example/consent/schemas/likeness-consent-credential.schema.json",
  "title": "Example Actors Guild Likeness Consent Credential",
  "description": "Example industry extension of the CAWG consent credential. The guild decides which consent terms are public; everything else stays in the private agreement committed to by privateTermsDigest.",
  "allOf": [
    { "$ref": "https://cawg.io/consent/schemas/cawg-consent-credential.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "contains": { "const": "ExampleGuildLikenessConsentCredential" } },
        "credentialSubject": {
          "required": ["consent"],
          "properties": {
            "consentDomain": { "const": "identity" },
            "consent": {
              "type": "object",
              "required": ["aspects", "permittedUses", "aiTraining", "territory"],
              "properties": {
                "aspects": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "enum": ["name", "image", "likeness", "voice", "movement", "mannerisms", "persona"] }
                },
                "permittedUses": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "enum": ["editorial", "promotional", "commercial", "archival"] }
                },
                "aiTraining": { "enum": ["allowed", "notAllowed"] },
                "digitalReplica": { "enum": ["allowed", "notAllowed"], "default": "notAllowed" },
                "territory": { "type": "string", "description": "ISO 3166-1 alpha-2 code, or WORLD" }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  ]
}
