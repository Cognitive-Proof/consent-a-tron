# Copy to .env and fill in. Never commit .env.

# MongoDB (docker compose up -d mongo)
MONGODB_URI=mongodb://localhost:27019
MONGODB_DB=consent_demo

# Stripe test mode only: sk_test_… (without it, payment is simulated)
STRIPE_SECRET_KEY=

# Resend (without it, emails only appear in each site's /outbox).
# Until you verify a domain in Resend, the onboarding@resend.dev sender
# only delivers to your own Resend account's email address.
RESEND_API_KEY=
EMAIL_FROM=Consent Demo <onboarding@resend.dev>

# Google Cloud Storage bucket for uploaded and signed files. Uses Application
# Default Credentials (the Cloud Run service account, or
# GOOGLE_APPLICATION_CREDENTIALS locally). Without it, files go to data/blobs/.
GCS_BUCKET=

# Public URLs of the three sites. Locally the defaults are
# http://localhost:4001 / 4002 / 4003. Deployed, they must share one
# registrable domain (subdomains), or the embedded wallet loses its keys.
CERT_SITE_URL=
WALLET_URL=
CONSENT_SITE_URL=
# The trust registry (registry/, local default http://localhost:4005).
REGISTRY_URL=
# Certificate emails allowed to use the registry's admin pages.
REGISTRY_ADMIN_EMAILS=
