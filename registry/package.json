{
  "name": "consent-trust-registry",
  "private": true,
  "version": "0.1.0",
  "description": "The guild's trust registry: TRQP queries plus producer access requests and admin approval",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cognitiveproof/cawg-trqp": "^0.17.1",
    "@cognitiveproof/cawg-trqp-plugin-admin": "^0.1.1",
    "express": "^4.21.2",
    "mongodb": "^6.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
